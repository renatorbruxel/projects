model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3

	role 'Seller'
		tablePermissions
			table 'Main'
				filterExpression
					= 'Main'[Seller_Email] = USERPRINCIPALNAME()
			table 'Gamification'
				filterExpression
					= 'Gamification'[Email] = USERPRINCIPALNAME()
			table 'Quota'
				filterExpression
					= 'Quota'[Seller_Email] = USERPRINCIPALNAME()

	role 'Manager'
		tablePermissions
			table 'Main'
				filterExpression
					= 'Main'[Manager_Email] = USERPRINCIPALNAME() || 'Main'[Seller_Email] = USERPRINCIPALNAME()

	role 'Regional_VP'
		tablePermissions
			table 'Main'
				filterExpression
					= 'Main'[Region_VP_Email] = USERPRINCIPALNAME() || 'Main'[Manager_Email] = USERPRINCIPALNAME() || 'Main'[Seller_Email] = USERPRINCIPALNAME()

	role 'Admin'
