table Calendar
	lineageTag: d0e1f2a3-b4c5-6789-defa-890123456789

	column Date
		dataType: dateTime
		isHidden
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456790
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456791
		summarizeBy: none
		expression = YEAR([Date])

	column Quarter
		dataType: string
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456792
		summarizeBy: none
		expression = "Q" & QUARTER([Date])

	column Month
		dataType: int64
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456793
		summarizeBy: none
		expression = MONTH([Date])

	column MonthName
		dataType: string
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456794
		summarizeBy: none
		sortByColumn: Month
		expression = FORMAT([Date], "MMM")

	column WeekNum
		dataType: int64
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456795
		summarizeBy: none
		expression = WEEKNUM([Date], 2)

	partition 'Calendar-calc'
		mode: calculated
		source
			= CALENDAR(DATE(2025, 1, 1), DATE(2027, 12, 31))
