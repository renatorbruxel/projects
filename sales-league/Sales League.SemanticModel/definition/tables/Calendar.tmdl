table Calendar
	lineageTag: d0e1f2a3-b4c5-6789-defa-890123456789

	column Date
		dataType: dateTime
		isHidden
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456790
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456791
		summarizeBy: none
		sourceColumn: [Year]

	column Quarter
		dataType: string
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456792
		summarizeBy: none
		sourceColumn: [Quarter]

	column Month
		dataType: int64
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456793
		summarizeBy: none
		sourceColumn: [Month]

	column MonthName
		dataType: string
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456794
		summarizeBy: none
		sortByColumn: Month
		sourceColumn: [MonthName]

	column WeekNum
		dataType: int64
		lineageTag: d0e1f2a3-b4c5-6789-defa-890123456795
		summarizeBy: none
		sourceColumn: [WeekNum]

	partition Calendar = calculated
		mode: import
		source =
			ADDCOLUMNS(
			    CALENDAR(DATE(2025, 1, 1), DATE(2027, 12, 31)),
			    "Year", YEAR([Date]),
			    "Quarter", "Q" & FORMAT(CEILING(MONTH([Date]) / 3, 1), "0"),
			    "Month", MONTH([Date]),
			    "MonthName", FORMAT([Date], "MMM"),
			    "WeekNum", WEEKNUM([Date], 2)
			)
