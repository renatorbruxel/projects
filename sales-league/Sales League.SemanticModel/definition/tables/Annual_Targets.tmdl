table Annual_Targets
	lineageTag: f2a3b4c5-d6e7-8901-fabc-012345678901

	column Region
		dataType: string
		lineageTag: f2a3b4c5-d6e7-8901-fabc-012345678902
		summarizeBy: none

	column Fiscal_Year
		dataType: string
		lineageTag: f2a3b4c5-d6e7-8901-fabc-012345678903
		summarizeBy: none

	column AOP_Target
		dataType: double
		lineageTag: f2a3b4c5-d6e7-8901-fabc-012345678904
		formatString: $#,0,,\M

	column Stretch_Target
		dataType: double
		lineageTag: f2a3b4c5-d6e7-8901-fabc-012345678905
		formatString: $#,0,,\M

	partition Annual_Targets-Partition
		mode: import
		source
			type: m
			expression
				= let
				    Source = #table(
				        type table [
				            Region = text,
				            Fiscal_Year = text,
				            AOP_Target = number,
				            Stretch_Target = number
				        ],
				        {
				            {"Americas","FY2026",3300000,3630000},
				            {"EMEA","FY2026",3152100,3467310},
				            {"APJ","FY2026",3385500,3724050},
				            {"Global","FY2026",9837600,10821360}
				        }
				    )
				in
				    Source

