	column Quarter
		dataType: string
		lineageTag: b2c3d4e5-f6a7-8901-bcde-f12345678930
		summarizeBy: none
		isDataTypeInferred: false
		expression
			= "Q" & QUARTER([Close_Date]) & " FY" & YEAR([Close_Date])

	column Is_Current_Quarter
		dataType: boolean
		lineageTag: b2c3d4e5-f6a7-8901-bcde-f12345678931
		expression
			= IF(QUARTER([Close_Date]) = QUARTER(TODAY()) && YEAR([Close_Date]) = YEAR(TODAY()), TRUE(), FALSE())

