table 'Pipeline'
	lineageTag: pip-001

	column Opportunity_ID
		dataType: string
		lineageTag: pip-c-001
		summarizeBy: none
		sourceColumn: Opportunity_ID

	column Opportunity_Name
		dataType: string
		lineageTag: pip-c-002
		summarizeBy: none
		sourceColumn: Opportunity_Name

	column Seller_Name
		dataType: string
		lineageTag: pip-c-003
		summarizeBy: none
		sourceColumn: Seller_Name

	column Region
		dataType: string
		lineageTag: pip-c-004
		summarizeBy: none
		sourceColumn: Region

	column Sub_Region
		dataType: string
		lineageTag: pip-c-005
		summarizeBy: none
		sourceColumn: Sub_Region

	column Product_Line
		dataType: string
		lineageTag: pip-c-006
		summarizeBy: none
		sourceColumn: Product_Line

	column Market
		dataType: string
		lineageTag: pip-c-007
		summarizeBy: none
		sourceColumn: Market

	column Country
		dataType: string
		lineageTag: pip-c-008
		summarizeBy: none
		sourceColumn: Country

	column Stage
		dataType: string
		lineageTag: pip-c-009
		summarizeBy: none
		sourceColumn: Stage

	column Forecast_Category
		dataType: string
		lineageTag: pip-c-010
		summarizeBy: none
		sourceColumn: Forecast_Category

	column ARR_USD
		dataType: double
		lineageTag: pip-c-011
		summarizeBy: sum
		sourceColumn: ARR_USD
		formatString: $#,0

	column Close_Date
		dataType: dateTime
		lineageTag: pip-c-012
		summarizeBy: none
		sourceColumn: Close_Date
		formatString: yyyy-MM-dd

	column Created_Date
		dataType: dateTime
		lineageTag: pip-c-013
		summarizeBy: none
		sourceColumn: Created_Date
		formatString: yyyy-MM-dd

	column Last_Modified_Date
		dataType: dateTime
		lineageTag: pip-c-014
		summarizeBy: none
		sourceColumn: Last_Modified_Date
		formatString: yyyy-MM-dd

	column Is_Overdue
		dataType: boolean
		lineageTag: pip-c-015
		summarizeBy: none
		sourceColumn: Is_Overdue

	column Is_Won
		dataType: boolean
		lineageTag: pip-c-016
		summarizeBy: none
		sourceColumn: Is_Won

	column Is_Net_New
		dataType: boolean
		lineageTag: pip-c-017
		summarizeBy: none
		sourceColumn: Is_Net_New

	column AKey
		dataType: string
		lineageTag: pip-c-018
		summarizeBy: none
		type: calculated
		expression = [Region] & [Sub_Region] & [Product_Line] & [Market]

