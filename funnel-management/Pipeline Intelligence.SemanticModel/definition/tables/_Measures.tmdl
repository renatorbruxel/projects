table '_Measures'
	lineageTag: fd3d0496-7151-8324-5086-fe9091d12c62

	measure 'Total Pipeline ARR' = SUM('Pipeline'[ARR_USD])
		formatString: $#,0,,\M
		lineageTag: ccc70a75-80dd-9676-b35c-bcebf517e859
		displayFolder: Pipeline

	measure 'Pipeline Coverage' = DIVIDE([Total Pipeline ARR], [Quota_AOP])
		formatString: 0.0x
		lineageTag: 8e2ab34d-122b-14a1-db5c-0b3228d28035
		displayFolder: Pipeline

	measure 'Quota_AOP' = SUM('Bookings_Actuals'[AOP_Bookings])
		formatString: $#,0,,\M
		lineageTag: fd158823-8ff4-2cf6-dfe1-1af46d2404c8
		displayFolder: Targets

	measure 'Actuals_Bookings' = SUM('Bookings_Actuals'[Actual_Bookings])
		formatString: $#,0,,\M
		lineageTag: 5ce2e646-ba0d-c94e-e303-b9f4e7e47a36
		displayFolder: Actuals

	measure 'Attainment_%' = DIVIDE([Actuals_Bookings], [Quota_AOP])
		formatString: 0.0%
		lineageTag: f380f0a6-49fd-5c07-eaef-74a13462529c
		displayFolder: Actuals

	measure 'Push_Out_Value' = SUM('Pipeline_Pushed'[ARR_USD])
		formatString: $#,0,,\M
		lineageTag: e2fca2a8-4ffc-ab53-263e-30ca47875a0e
		displayFolder: Pipeline Dynamics

	measure 'Push_Out_Count' = COUNTROWS('Pipeline_Pushed')
		lineageTag: 8c3e8b4c-bb82-eb70-0bfc-062042509884
		displayFolder: Pipeline Dynamics

	measure 'Overdue_Pipeline' = CALCULATE([Total Pipeline ARR], 'Pipeline'[Is_Overdue] = TRUE())
		formatString: $#,0,,\M
		lineageTag: 8f505fbd-9804-d0e4-75f9-0230edc000b2
		displayFolder: Hygiene

	measure 'Win_Rate' = DIVIDE(CALCULATE(COUNTROWS('Pipeline'), 'Pipeline'[Stage] = "Closed Won"), CALCULATE(COUNTROWS('Pipeline'), 'Pipeline'[Stage] IN {"Closed Won", "Closed Lost"}))
		formatString: 0.0%
		lineageTag: 8271f11d-8477-5d13-3350-c3a70674a0b5
		displayFolder: Performance

	measure 'Weekly_Pacing_Required' = DIVIDE([Quota_AOP] - [Actuals_Bookings], MAX('Calendar'[Days_Remaining_in_Quarter]))
		formatString: $#,0,,\M
		lineageTag: 6a5d8015-8535-d4a0-61b6-a848a3113d94
		displayFolder: Actuals

	measure 'Pipeline_WoW_Delta' = [Total Pipeline ARR] - CALCULATE([Total Pipeline ARR], DATEADD('Calendar'[Date], -7, DAY))
		formatString: $#,0,,\M
		lineageTag: db415410-2198-ff2a-fe83-bd15fdcb411f
		displayFolder: Pipeline Dynamics

	measure 'Current_Quarter_Coverage' = DIVIDE(CALCULATE([Total Pipeline ARR], QUARTER('Pipeline'[Close_Date]) = QUARTER(TODAY())), CALCULATE([Quota_AOP], QUARTER('Bookings_Actuals'[Booking_Date]) = QUARTER(TODAY())))
		formatString: 0.0x
		lineageTag: 78d8e083-9f40-6a6c-b208-bf029d7bd399
		displayFolder: Pipeline

	measure 'PullIn_Value' = SUM('Pipeline_PullIn'[ARR_USD])
		formatString: $#,0,,\M
		lineageTag: f90f7fe9-c2fe-2e31-b5da-09904fa3b9d0
		displayFolder: Pipeline Dynamics

	measure 'PullIn_Count' = COUNTROWS('Pipeline_PullIn')
		lineageTag: 4e1245c5-5d43-c2cb-6d6f-fe23a4dd5d34
		displayFolder: Pipeline Dynamics

	measure 'Net_Push_Impact' = [Push_Out_Value] - [PullIn_Value]
		formatString: $#,0,,\M
		lineageTag: 5c8dcc78-0142-d3b2-b411-d870d4fa5da1
		displayFolder: Pipeline Dynamics

	measure 'Pipeline_Stage_Mix_%' = DIVIDE([Total Pipeline ARR], CALCULATE([Total Pipeline ARR], ALL('Pipeline'[Stage])))
		formatString: 0.0%
		lineageTag: 6b50cdf9-e08b-4eec-1a4a-039472758404
		displayFolder: Pipeline

	measure 'Avg_Deal_Size' = AVERAGEX('Pipeline', 'Pipeline'[ARR_USD])
		formatString: $#,0
		lineageTag: ec3d704d-3cdf-1262-0ab5-ce252cc9dcd3
		displayFolder: Performance

	measure 'Open_Opportunities' = CALCULATE(COUNTROWS('Pipeline'), 'Pipeline'[Stage] NOT IN {"Closed Won", "Closed Lost"})
		lineageTag: e7866be8-d040-28d1-58e7-fdd38700d472
		displayFolder: Pipeline

	partition _Measures = m
		mode: import
		source =
			#table({"Placeholder"}, {{""}})
