							[Region = "EMEA", Sub_Region = "All", Product_Line = "All", Market = "All", Booking_Date = #date(2026, 12, 31), AOP_Bookings = 65000000.0, Q1FC_Bookings = 69000000.0, Q2FC_Bookings = 66000000.0, Q3FC_Bookings = 64000000.0, Q4FC_Bookings = 63000000.0, Actual_Bookings = 0.0, AKey = "EMEAAllAllAll"],
