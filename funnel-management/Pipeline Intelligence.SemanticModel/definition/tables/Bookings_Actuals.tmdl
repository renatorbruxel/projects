table 'Bookings_Actuals'
	lineageTag: bka-001

	column Region
		dataType: string
		lineageTag: bka-c-001
		summarizeBy: none
		sourceColumn: Region

	column Sub_Region
		dataType: string
		lineageTag: bka-c-002
		summarizeBy: none
		sourceColumn: Sub_Region

	column Product_Line
		dataType: string
		lineageTag: bka-c-003
		summarizeBy: none
		sourceColumn: Product_Line

	column Market
		dataType: string
		lineageTag: bka-c-004
		summarizeBy: none
		sourceColumn: Market

	column Booking_Date
		dataType: dateTime
		lineageTag: bka-c-005
		summarizeBy: none
		sourceColumn: Booking_Date
		formatString: yyyy-MM-dd

	column AOP_Bookings
		dataType: double
		lineageTag: bka-c-006
		summarizeBy: sum
		sourceColumn: AOP_Bookings
		formatString: $#,0

	column Q1FC_Bookings
		dataType: double
		lineageTag: bka-c-007
		summarizeBy: sum
		sourceColumn: Q1FC_Bookings
		formatString: $#,0

	column Q2FC_Bookings
		dataType: double
		lineageTag: bka-c-008
		summarizeBy: sum
		sourceColumn: Q2FC_Bookings
		formatString: $#,0

	column Q3FC_Bookings
		dataType: double
		lineageTag: bka-c-009
		summarizeBy: sum
		sourceColumn: Q3FC_Bookings
		formatString: $#,0

	column Q4FC_Bookings
		dataType: double
		lineageTag: bka-c-010
		summarizeBy: sum
		sourceColumn: Q4FC_Bookings
		formatString: $#,0

	column Actual_Bookings
		dataType: double
		lineageTag: bka-c-011
		summarizeBy: sum
		sourceColumn: Actual_Bookings
		formatString: $#,0

	column AKey
		dataType: string
		lineageTag: bka-c-012
		summarizeBy: none
		sourceColumn: AKey

	partition 'Bookings_Actuals-partition'
		mode: import
		source
			type: m
