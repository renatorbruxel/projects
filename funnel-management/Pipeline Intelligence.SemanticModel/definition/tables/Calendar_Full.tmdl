table 'Calendar_Full'
	lineageTag: d8a831f6-7b39-deeb-4692-79877c6fec12

	column Date
		dataType: dateTime
		isHidden
		lineageTag: 711ef957-08d6-5bac-ba67-437a2f0c491f
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		lineageTag: 237c0c2d-9e44-75dc-5d7f-70e6e1c00251
		summarizeBy: none
		expression = YEAR([Date])

	column Quarter
		dataType: string
		lineageTag: ce1a5555-ea44-e853-f5a5-cb84cc43acb4
		summarizeBy: none
		expression = "Q" & FORMAT(QUARTER([Date]), "0") & " FY" & RIGHT(TEXT(YEAR([Date]), "0000"), 2)

	column Month
		dataType: int64
		lineageTag: c51048d3-c4e6-a07a-db72-361a2429d066
		summarizeBy: none
		expression = MONTH([Date])

	column WeekNum
		dataType: int64
		lineageTag: a005e3a8-2c94-6145-1db7-7066ebed516b
		summarizeBy: none
		expression = WEEKNUM([Date], 2)

	column ISO_Week_Label
		dataType: string
		lineageTag: a88839d3-5b47-82bd-6bd1-8dd1663fa485
		summarizeBy: none
		expression = "W" & FORMAT(WEEKNUM([Date], 2), "00") & "-" & FORMAT(YEAR([Date]), "0000")

	partition Calendar_Full = calculated
		mode: import
		source =
			CALENDAR(DATE(2024, 1, 1), DATE(2027, 12, 31))
