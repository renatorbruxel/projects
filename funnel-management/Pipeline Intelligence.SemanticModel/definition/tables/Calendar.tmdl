table 'Calendar'
	lineageTag: 3488e599-2816-4777-29ab-26061e1f287a

	column Date
		dataType: dateTime
		isHidden
		lineageTag: 8f784d28-d999-06eb-57a2-bfee7d88631d
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		lineageTag: 26d3320d-a690-55e3-3e23-09040f069ce6
		summarizeBy: none
		expression = YEAR([Date])

	column Quarter
		dataType: string
		lineageTag: 6d5bf4fa-6758-9b52-7641-3d364d1b707a
		summarizeBy: none
		expression = "Q" & FORMAT(QUARTER([Date]), "0") & " FY" & RIGHT(TEXT(YEAR([Date]), "0000"), 2)

	column Month
		dataType: int64
		lineageTag: 42ddc45b-e78b-47df-6820-e704ab13436f
		summarizeBy: none
		expression = MONTH([Date])

	column MonthName
		dataType: string
		lineageTag: 29fc56e5-291a-8760-8e48-1887f37fa546
		summarizeBy: none
		expression = FORMAT([Date], "MMM")
		sortByColumn: Month

	column WeekNum
		dataType: int64
		lineageTag: fe5263d0-d206-3aa0-f798-38618326edf3
		summarizeBy: none
		expression = WEEKNUM([Date], 2)

	column Days_Remaining_in_Quarter
		dataType: int64
		lineageTag: 170502fb-1d9d-4e54-b7b6-09f20efa0ac7
		summarizeBy: none
		expression =
			var qEnd =
				SWITCH(
					QUARTER([Date]),
					1, DATE(YEAR([Date]), 3, 31),
					2, DATE(YEAR([Date]), 6, 30),
					3, DATE(YEAR([Date]), 9, 30),
					DATE(YEAR([Date]), 12, 31)
				)
			return INT(qEnd - [Date])

	partition Calendar = calculated
		mode: import
		source =
			CALENDAR(DATE(2025, 1, 1), DATE(2027, 12, 31))
