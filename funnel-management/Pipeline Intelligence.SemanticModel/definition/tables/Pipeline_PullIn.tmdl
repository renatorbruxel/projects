table 'Pipeline_PullIn'
	lineageTag: ppull-001

	column Opportunity_ID
		dataType: string
		lineageTag: ppull-c-001
		summarizeBy: none
		sourceColumn: Opportunity_ID

	column Opportunity_Name
		dataType: string
		lineageTag: ppull-c-002
		summarizeBy: none
		sourceColumn: Opportunity_Name

	column Seller_Name
		dataType: string
		lineageTag: ppull-c-003
		summarizeBy: none
		sourceColumn: Seller_Name

	column ARR_USD
		dataType: double
		lineageTag: ppull-c-004
		summarizeBy: sum
		sourceColumn: ARR_USD
		formatString: $#,0

	column Original_Close_Date
		dataType: dateTime
		lineageTag: ppull-c-005
		summarizeBy: none
		sourceColumn: Original_Close_Date
		formatString: yyyy-MM-dd

	column New_Close_Date
		dataType: dateTime
		lineageTag: ppull-c-006
		summarizeBy: none
		sourceColumn: New_Close_Date
		formatString: yyyy-MM-dd

	column Pull_Reason
		dataType: string
		lineageTag: ppull-c-007
		summarizeBy: none
		sourceColumn: Pull_Reason

	column AKey
		dataType: string
		lineageTag: ppull-c-008
		summarizeBy: none
		sourceColumn: AKey

	column Days_Pulled
		dataType: int64
		lineageTag: ppull-c-009
		summarizeBy: sum
		expression = INT([Original_Close_Date] - [New_Close_Date])

	partition 'Pipeline_PullIn-partition'
		mode: import
		source
			type: m
			expression
				= let
					Source = Table.FromRecords(
						{
							[Opportunity_ID = "OP-1003", Opportunity_Name = "Microsoft Azure Expansion", Seller_Name = "Jennifer Park", ARR_USD = 2300000.0, Original_Close_Date = #date(2026, 12, 31), New_Close_Date = #date(2026, 12, 15), Pull_Reason = "Customer accelerated decision", AKey = "AmericasNAMStorage PlatformEnterprise"],
							[Opportunity_ID = "OP-1004", Opportunity_Name = "Adobe Analytics Suite", Seller_Name = "David Torres", ARR_USD = 320000.0, Original_Close_Date = #date(2026, 9, 30), New_Close_Date = #date(2026, 9, 15), Pull_Reason = "Competitive pressure - fast close", AKey = "AmericasNAMAnalytics CloudMid-Market"],
							[Opportunity_ID = "OP-2004", Opportunity_Name = "Orange Telecom Platform", Seller_Name = "Sofia Martinez", ARR_USD = 420000.0, Original_Close_Date = #date(2026, 10, 31), New_Close_Date = #date(2026, 9, 30), Pull_Reason = "Q3 budget available", AKey = "EMEAWEUData IntelligenceCommercial"],
							[Opportunity_ID = "OP-2005", Opportunity_Name = "Deutsche Telekom Data Hub", Seller_Name = "Hans Mueller", ARR_USD = 1100000.0, Original_Close_Date = #date(2026, 9, 30), New_Close_Date = #date(2026, 9, 15), Pull_Reason = "Executive push to close Q3", AKey = "EMEACEEStorage PlatformEnterprise"],
							[Opportunity_ID = "OP-3003", Opportunity_Name = "Fujitsu Enterprise Suite", Seller_Name = "Kenji Yamamoto", ARR_USD = 975000.0, Original_Close_Date = #date(2026, 10, 31), New_Close_Date = #date(2026, 9, 30), Pull_Reason = "Fiscal year alignment with customer", AKey = "APJANZAnalytics CloudEnterprise"],
							[Opportunity_ID = "OP-3002", Opportunity_Name = "TCS Platform Expansion", Seller_Name = "Priya Singh", ARR_USD = 290000.0, Original_Close_Date = #date(2026, 10, 31), New_Close_Date = #date(2026, 9, 30), Pull_Reason = "Contract expedited", AKey = "APJSEAStorage PlatformMid-Market"]
						},
						type table [
							Opportunity_ID = text,
							Opportunity_Name = text,
							Seller_Name = text,
							ARR_USD = number,
							Original_Close_Date = date,
							New_Close_Date = date,
							Pull_Reason = text,
							AKey = text
						]
					)
				in
					Source
