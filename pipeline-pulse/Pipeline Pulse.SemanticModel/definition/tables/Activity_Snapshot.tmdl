table 'Activity_Snapshot'
	lineageTag: acs-001

	column 'Snapshot_Date'
		dataType: dateTime
		lineageTag: acs-002
		summarizeBy: none
		sourceColumn: Snapshot_Date
		formatString: yyyy-MM-dd

	column 'Region'
		dataType: string
		lineageTag: acs-003
		summarizeBy: none
		sourceColumn: Region

	column 'Seller_Email'
		dataType: string
		lineageTag: acs-004
