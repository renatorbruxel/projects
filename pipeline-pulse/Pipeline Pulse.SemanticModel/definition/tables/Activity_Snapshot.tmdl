	column 'Activity_Type'
		dataType: string
		lineageTag: acs-005
		summarizeBy: none
		sourceColumn: Activity_Type

	column 'Activity_Count'
		dataType: int64
		lineageTag: acs-006
		summarizeBy: sum
		sourceColumn: Activity_Count

	column 'Opps_Touched'
		dataType: int64
		lineageTag: acs-007
		summarizeBy: sum
		sourceColumn: Opps_Touched

