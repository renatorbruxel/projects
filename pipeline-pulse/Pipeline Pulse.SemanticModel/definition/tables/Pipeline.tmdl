table 'Pipeline'
	lineageTag: pip-001

	column 'Opportunity_ID'
		dataType: string
		lineageTag: pip-002
		summarizeBy: none
		sourceColumn: Opportunity_ID

	column 'Opportunity_Name'
		dataType: string
		lineageTag: pip-003
		summarizeBy: none
		sourceColumn: Opportunity_Name

	column 'Account_Name'
		dataType: string
		lineageTag: pip-004
		summarizeBy: none
		sourceColumn: Account_Name

	column 'Seller_Name'
		dataType: string
		lineageTag: pip-005
		summarizeBy: none
		sourceColumn: Seller_Name

	column 'Seller_Email'
		dataType: string
		lineageTag: pip-006
		summarizeBy: none
		sourceColumn: Seller_Email

	column 'Manager_Email'
		dataType: string
		lineageTag: pip-007
		summarizeBy: none
		sourceColumn: Manager_Email

	column 'Region'
		dataType: string
		lineageTag: pip-008
		summarizeBy: none
		sourceColumn: Region

	column 'Sub_Region'
		dataType: string
		lineageTag: pip-009
		summarizeBy: none
		sourceColumn: Sub_Region

	column 'Market'
		dataType: string
		lineageTag: pip-010
		summarizeBy: none
		sourceColumn: Market

	column 'Product_Line'
		dataType: string
		lineageTag: pip-011
		summarizeBy: none
		sourceColumn: Product_Line

	column 'Territory'
		dataType: string
		lineageTag: pip-012
		summarizeBy: none
		sourceColumn: Territory

	column 'Stage'
		dataType: string
		lineageTag: pip-013
		summarizeBy: none
		sourceColumn: Stage

	column 'Forecast_Category'
		dataType: string
		lineageTag: pip-014
		summarizeBy: none
		sourceColumn: Forecast_Category

	column 'Is_Won_Loss_Open'
		dataType: string
		lineageTag: pip-015
		summarizeBy: none
		sourceColumn: Is_Won_Loss_Open

	column 'ARR_USD'
		dataType: double
		lineageTag: pip-016
		summarizeBy: sum
		sourceColumn: ARR_USD
		formatString: $#,0

	column 'Close_Date'
		dataType: dateTime
		lineageTag: pip-017
		summarizeBy: none
		sourceColumn: Close_Date
		formatString: yyyy-MM-dd

	column 'Created_Date'
		dataType: dateTime
		lineageTag: pip-018
		summarizeBy: none
		sourceColumn: Created_Date
		formatString: yyyy-MM-dd

	column 'Last_Modified_Date'
		dataType: dateTime
		lineageTag: pip-019
		summarizeBy: none
		sourceColumn: Last_Modified_Date
		formatString: yyyy-MM-dd

	column 'Last_Activity_Date'
		dataType: dateTime
		lineageTag: pip-020
		summarizeBy: none
		sourceColumn: Last_Activity_Date
		formatString: yyyy-MM-dd

	column 'Days_Since_Last_Activity'
		dataType: int64
		lineageTag: pip-021
		summarizeBy: average
		sourceColumn: Days_Since_Last_Activity

	column 'Is_Overdue'
		dataType: boolean
		lineageTag: pip-022
		summarizeBy: none
		sourceColumn: Is_Overdue

	column 'Is_Healthy'
		dataType: boolean
		lineageTag: pip-023
		summarizeBy: none
		sourceColumn: Is_Healthy

	column 'Is_Net_New'
		dataType: boolean
		lineageTag: pip-024
		summarizeBy: none
		sourceColumn: Is_Net_New

	column 'Is_Push_Out'
		dataType: boolean
		lineageTag: pip-025
		summarizeBy: none
		sourceColumn: Is_Push_Out

	column 'AKey'
		dataType: string
		lineageTag: pip-026
		summarizeBy: none
		sourceColumn: AKey

	calculatedColumn 'Quarter_Bucket'
		dataType: string
		lineageTag: pip-027
		summarizeBy: none
		expression =
				IF(
					QUARTER([Close_Date]) = QUARTER(TODAY())
						&& YEAR([Close_Date]) = YEAR(TODAY()),
					"CQ",
					IF(
						QUARTER([Close_Date]) = QUARTER(TODAY()) + 1
							&& YEAR([Close_Date]) = YEAR(TODAY()),
						"NQ",
						"NQ+"
					)
				)

	partition 'Pipeline-partition-0' = m
