table 'Conversion_Rate'
	lineageTag: cvr-001

	column 'From_Stage'
		dataType: string
		lineageTag: cvr-002
		summarizeBy: none
		sourceColumn: From_Stage

	column 'To_Stage'
		dataType: string
		lineageTag: cvr-003
		summarizeBy: none
		sourceColumn: To_Stage

	column 'Product_Line'
		dataType: string
		lineageTag: cvr-004
		summarizeBy: none
		sourceColumn: Product_Line

	column 'Market'
		dataType: string
		lineageTag: cvr-005
		summarizeBy: none
		sourceColumn: Market

	column 'Conversion_%'
		dataType: double
		lineageTag: cvr-006
		summarizeBy: average
		sourceColumn: Conversion_%
		formatString: 0.0%

	column 'Avg_Days_in_Stage'
		dataType: int64
		lineageTag: cvr-007
		summarizeBy: average
		sourceColumn: Avg_Days_in_Stage

	partition 'Conversion_Rate-partition-0' = m
		mode: import
		source =
			let
