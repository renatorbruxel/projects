table 'Pipeline_Snapshot'
	lineageTag: pss-001

	column 'Snapshot_Date'
		dataType: dateTime
		lineageTag: pss-002
		summarizeBy: none
		sourceColumn: Snapshot_Date
		formatString: yyyy-MM-dd

	column 'Region'
		dataType: string
		lineageTag: pss-003
