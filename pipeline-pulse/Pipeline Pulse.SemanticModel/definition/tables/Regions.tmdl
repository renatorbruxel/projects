						{"EMEA","EMEA South","Sophie Laurent","s.laurent@vantara-fictional.demo","EMEA",276000000},
						{"EMEA","EMEA North","Sophie Laurent","s.laurent@vantara-fictional.demo","EMEA",276000000},
