table '_Measures'
	lineageTag: d795b74a-eefc-addd-8bbd-177d45ee674a

	/// ─── Coverage ───────────────────────────────────────────────────────────

	measure 'Total_Pipeline_ARR' =
			SUM('Pipeline'[ARR_USD])
		lineageTag: 903b36a3-0c16-fc8b-bfbd-fd82e6208d7a
		displayFolder: Coverage
		formatString: $#,0,,\M

	measure 'Quota_AOP' =
			SUM('Bookings_Actuals'[AOP_Bookings])
		lineageTag: d00710da-977c-5613-ce6e-c1e7b98d9c5c
		displayFolder: Targets
		formatString: $#,0,,\M

	measure 'Coverage_3x_Ratio' =
			DIVIDE([Total_Pipeline_ARR], [Quota_AOP])
		lineageTag: 6a1a6201-ed16-0115-e289-477579791b13
		displayFolder: Coverage
		formatString: 0.0"x"

	measure 'Coverage_Status' =
			IF(
				[Coverage_3x_Ratio] >= 3,
				"Above 3x ✓",
				IF([Coverage_3x_Ratio] >= 2, "Below 3x ⚠", "Critical <2x ✗")
			)
		lineageTag: 9384e90f-1b23-3c6d-eb02-a8a36af8e5ae
		displayFolder: Coverage

	measure 'Gap_to_3x' =
			MAX(0, [Quota_AOP] * 3 - [Total_Pipeline_ARR])
		lineageTag: a2477dd7-3398-82b7-1b6a-32f396505709
		displayFolder: Coverage
		formatString: $#,0,,\M

	measure 'CQ_Pipeline' =
			CALCULATE(
				[Total_Pipeline_ARR],
				QUARTER('Pipeline'[Close_Date]) = QUARTER(TODAY())
					&& YEAR('Pipeline'[Close_Date]) = YEAR(TODAY())
			)
		lineageTag: fcf0d278-7099-02ff-8e56-1017cc635447
		displayFolder: Coverage
		formatString: $#,0,,\M

	measure 'NQ_Pipeline' =
			CALCULATE(
				[Total_Pipeline_ARR],
				QUARTER('Pipeline'[Close_Date]) = QUARTER(TODAY()) + 1
					&& YEAR('Pipeline'[Close_Date]) = YEAR(TODAY())
			)
		lineageTag: acd0b39a-7497-00c5-3ada-0627ac739ab3
		displayFolder: Coverage
		formatString: $#,0,,\M

	measure 'FY_Pipeline' =
			CALCULATE(
				[Total_Pipeline_ARR],
				YEAR('Pipeline'[Close_Date]) = YEAR(TODAY())
			)
		lineageTag: e2aed8ef-de2a-3e89-fb4c-c7778e97f488
		displayFolder: Coverage
		formatString: $#,0,,\M

	measure 'Open_Opportunity_Count' =
			CALCULATE(
				COUNTROWS('Pipeline'),
				'Pipeline'[Is_Won_Loss_Open] = "Open"
			)
		lineageTag: fab268c9-98e0-3519-9681-16f6fadbc18d
		displayFolder: Coverage

	measure 'Avg_Deal_Size_ARR' =
			DIVIDE([Total_Pipeline_ARR], [Open_Opportunity_Count])
		lineageTag: dbb3d418-df6c-aade-c1ee-ee1b50d27acc
		displayFolder: Coverage
		formatString: $#,0,\K

	/// ─── WoW Changes ────────────────────────────────────────────────────────

	measure 'Pipeline_WoW_Delta' =
			[Total_Pipeline_ARR]
				- CALCULATE([Total_Pipeline_ARR], DATEADD('Calendar'[Date], -7, DAY))
		lineageTag: c84f7ac6-4540-c45e-354f-e4a6773238de
		displayFolder: WoW Changes
		formatString: $#,0,,\M

	measure 'Pipeline_DoD_Delta' =
			[Total_Pipeline_ARR]
				- CALCULATE([Total_Pipeline_ARR], DATEADD('Calendar'[Date], -1, DAY))
		lineageTag: 512859a7-235b-3ff4-7f9f-5155e4e3512b
		displayFolder: WoW Changes
		formatString: $#,0,,\M

	measure 'Pipeline_Build_Rate' =
			DIVIDE(
				[Pipeline_WoW_Delta],
				CALCULATE([Total_Pipeline_ARR], DATEADD('Calendar'[Date], -7, DAY))
			)
		lineageTag: be8e170e-b6f8-35e1-0a52-3c0a9fb36252
		displayFolder: WoW Changes
		formatString: +0.0%;-0.0%

	measure 'Opps_Added_WoW' =
			CALCULATE(COUNTROWS('Pipeline'), NOT(ISBLANK('Pipeline'[Opportunity_ID])))
				- CALCULATE(COUNTROWS('Pipeline'), DATEADD('Calendar'[Date], -7, DAY))
		lineageTag: 3c4a47cb-e57f-1440-3c2e-56ccdedec6a9
		displayFolder: WoW Changes

	measure 'Opps_Removed_WoW' =
			ABS(MIN(0, [Opps_Added_WoW]))
		lineageTag: d3ee399c-652d-60cd-dacb-14297576eb64
		displayFolder: WoW Changes

	measure 'Pipeline_4W_Trend' =
			VAR _current = [Total_Pipeline_ARR]
			VAR _4w_ago = CALCULATE([Total_Pipeline_ARR], DATEADD('Calendar'[Date], -28, DAY))
			RETURN DIVIDE(_current - _4w_ago, _4w_ago)
		lineageTag: 96baa831-31b9-1d31-77fb-71bb511711e2
		displayFolder: WoW Changes
		formatString: +0.0%;-0.0%

	/// ─── Funnel Hygiene ─────────────────────────────────────────────────────

	measure 'Hygiene_Score' =
			DIVIDE(
				CALCULATE(COUNTROWS('Pipeline'), 'Pipeline'[Is_Healthy] = TRUE()),
				COUNTROWS('Pipeline')
			)
		lineageTag: 57955fe0-5a58-0a3f-45a4-c62b9e451f0f
		displayFolder: Hygiene
		formatString: 0.0%

	measure 'Overdue_Pipeline_ARR' =
			CALCULATE([Total_Pipeline_ARR], 'Pipeline'[Is_Overdue] = TRUE())
		lineageTag: b733e782-9928-47e7-9797-f5e7d3adab06
		displayFolder: Hygiene
		formatString: $#,0,,\M

	measure 'Overdue_Pipeline_%' =
			DIVIDE([Overdue_Pipeline_ARR], [Total_Pipeline_ARR])
		lineageTag: 7c4d79a4-b1c9-dc04-4c4f-f8ef9d0e7622
		displayFolder: Hygiene
		formatString: 0.0%

	measure 'Stale_Opportunities' =
			CALCULATE(
				COUNTROWS('Pipeline'),
				'Pipeline'[Days_Since_Last_Activity] > 14
			)
		lineageTag: 887b67a4-1d54-1cb8-4db4-477e17a13d6b
		displayFolder: Hygiene

	measure 'Composite_Hygiene_Score' =
			INT(
				(
					[Hygiene_Score] * 0.4
						+ (1 - [Overdue_Pipeline_%]) * 0.3
						+ (
							1
								- DIVIDE(
									[Stale_Opportunities],
									COUNTROWS('Pipeline')
								)
						) * 0.3
				) * 100
			)
		lineageTag: 141750ba-a7ee-27f2-f872-befafc645d3d
		displayFolder: Hygiene
		formatString: 0

	measure 'Push_Out_Pipeline_ARR' =
			CALCULATE([Total_Pipeline_ARR], 'Pipeline'[Is_Push_Out] = TRUE())
		lineageTag: bb2a004f-3689-8371-e0b0-d01da138d933
		displayFolder: Hygiene
		formatString: $#,0,,\M

	measure 'Push_Out_%' =
			DIVIDE([Push_Out_Pipeline_ARR], [Total_Pipeline_ARR])
		lineageTag: 822f5fb1-06dc-0dc2-c057-c349351835d1
		displayFolder: Hygiene
		formatString: 0.0%

	measure 'Net_New_Pipeline_ARR' =
			CALCULATE([Total_Pipeline_ARR], 'Pipeline'[Is_Net_New] = TRUE())
		lineageTag: 36185c57-067c-e969-cd1b-3601e56edf3b
		displayFolder: Hygiene
		formatString: $#,0,,\M

	/// ─── Activity ────────────────────────────────────────────────────────────

	measure 'Total_Activities_WoW' =
			CALCULATE(
				COUNTROWS('Activity_Log'),
				DATESINPERIOD('Calendar'[Date], TODAY(), -7, DAY)
			)
		lineageTag: 76bfd3ad-3edc-22a8-b89f-bc362e6138a8
		displayFolder: Activity

	measure 'Avg_Activities_Per_Seller' =
			DIVIDE(
				[Total_Activities_WoW],
				DISTINCTCOUNT('Pipeline'[Seller_Email])
			)
		lineageTag: 0d0e26d5-71db-98f4-6ea7-9d7c3f29f9c0
		displayFolder: Activity
		formatString: 0.0

	measure 'Inactive_Opportunities' =
			CALCULATE(
				COUNTROWS('Pipeline'),
				'Pipeline'[Days_Since_Last_Activity] > 14
					&& 'Pipeline'[Is_Won_Loss_Open] = "Open"
			)
		lineageTag: 4251d331-ff5e-72f1-375d-25de847cda30
		displayFolder: Activity

	measure 'Meetings_Booked_WoW' =
			CALCULATE(
				COUNTROWS('Activity_Log'),
				'Activity_Log'[Activity_Type] = "Meeting",
				DATESINPERIOD('Calendar'[Date], TODAY(), -7, DAY)
			)
		lineageTag: 2d37f493-3f4e-d476-e989-0bc9ca0c7b5b
		displayFolder: Activity

	measure 'Calls_WoW' =
			CALCULATE(
				COUNTROWS('Activity_Log'),
				'Activity_Log'[Activity_Type] = "Call",
				DATESINPERIOD('Calendar'[Date], TODAY(), -7, DAY)
			)
		lineageTag: 219391cd-5fac-add5-7060-cd9fa5146a89
		displayFolder: Activity

	/// ─── Attainment ──────────────────────────────────────────────────────────

	measure 'Actuals_Bookings_YTD' =
			CALCULATE(
				SUM('Bookings_Actuals'[Actual_Bookings]),
				DATESYTD('Calendar'[Date])
			)
		lineageTag: 52310226-d1d8-3df5-c956-af77febc7296
		displayFolder: Attainment
		formatString: $#,0,,\M

	measure 'Attainment_%' =
			DIVIDE([Actuals_Bookings_YTD], [Quota_AOP])
		lineageTag: 4c456c05-a612-3070-f987-59ee8e25f99e
		displayFolder: Attainment
		formatString: 0.0%

	measure 'Pacing_Required_Weekly' =
			DIVIDE(
				[Quota_AOP] - [Actuals_Bookings_YTD],
				CALCULATE(
					COUNTROWS('Calendar'),
					'Calendar'[Date] >= TODAY()
						&& 'Calendar'[Date] <= EOMONTH(TODAY(), 2)
				) / 7
			)
		lineageTag: 5f5bf67d-5f4e-98aa-3ecd-b9ddf6dd8799
		displayFolder: Attainment
		formatString: $#,0,,\M

	measure 'Quota_Remaining' =
			[Quota_AOP] - [Actuals_Bookings_YTD]
		lineageTag: 7843c4c2-6d24-ad30-29e7-0ea8fe5bc6f0
		displayFolder: Attainment
		formatString: $#,0,,\M

	measure 'Attainment_Band' =
			SWITCH(
				TRUE(),
				[Attainment_%] >= 1.0, "Above Quota",
				[Attainment_%] >= 0.9, "90–100%",
				[Attainment_%] >= 0.75, "75–90%",
				[Attainment_%] >= 0.5, "50–75%",
				"Below 50%"
			)
		lineageTag: 6ed12f78-82d9-a9e2-2e71-505486e593f5
		displayFolder: Attainment

	/// ─── Forecast ────────────────────────────────────────────────────────────

	measure 'Commit_ARR' =
			CALCULATE([Total_Pipeline_ARR], 'Forecast_Categories'[Forecast_Category] = "Commit")
		lineageTag: dbfa5bca-b3a3-00bd-b4e0-c0f4ef2d5793
		displayFolder: Forecast
		formatString: $#,0,,\M

	measure 'Best_Case_ARR' =
			CALCULATE([Total_Pipeline_ARR], 'Forecast_Categories'[Forecast_Category] = "Best Case")
		lineageTag: 88e12352-1369-6837-ac69-6c01a092b3aa
		displayFolder: Forecast
		formatString: $#,0,,\M

	measure 'Commit_Plus_BestCase' =
			[Commit_ARR] + [Best_Case_ARR]
		lineageTag: 5d068214-1c34-e8ab-c975-9f769c57e6bc
		displayFolder: Forecast
		formatString: $#,0,,\M

	measure 'Weighted_Forecast_ARR' =
			SUMX(
				RELATEDTABLE('Forecast_Categories'),
				[Total_Pipeline_ARR] * 'Forecast_Categories'[Probability_%]
			)
		lineageTag: 85f33b20-c635-0092-ea16-8bab6adeb6fe
		displayFolder: Forecast
		formatString: $#,0,,\M

	measure 'Forecast_vs_Quota_%' =
			DIVIDE([Commit_ARR], [Quota_AOP])
		lineageTag: ba3d5221-096a-f109-9410-d4b58606e63d
		displayFolder: Forecast
		formatString: 0.0%

	/// ─── Reference (blank table anchor) ──────────────────────────────────────

	column '_Placeholder'
		dataType: string
		lineageTag: b155c374-d792-d96e-f21d-549b475b7072
		summarizeBy: none
		isHidden
		sourceColumn: _Placeholder

	partition '_Measures-partition-0' = m
		mode: import
		source =
			let
				Source = #table(
					type table [_Placeholder = text],
					{{""}}
				)
			in
				Source
