# Whitelist approach — portfolio subfolders are fully tracked
# Keep local source/reference files out of the public portfolio

# Exclude everything by default
*

# Allow directories to be traversed
!*/

# Always allow
!.gitignore
!README.md
!index.html
!portfolio-deep-dive.html

# Allow all content inside the 5 portfolio project subfolders
!weekly-checkin-portal/**
!funnel-management/**
!net-new-tracker/**
!pipeline-pulse/**
!sales-league/**

# Review documentation and verification code
!docs/**
!tests/**
# Never publish local secrets or generated source exports
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/__pycache__/
**/*.pyc
