table Opportunity_Pipeline
	lineageTag: a0000007-0000-0000-0000-000000000001

	column Opportunity_ID
		dataType: string
		lineageTag: a0000007-0000-0000-0000-000000000002
		summarizeBy: none
		isKey: true
		sourceColumn: Opportunity_ID

	column Account_Name
		dataType: string
		lineageTag: a0000007-0000-0000-0000-000000000003
		summarizeBy: none
		sourceColumn: Account_Name

	column Stage
		dataType: string
		lineageTag: a0000007-0000-0000-0000-000000000004
		summarizeBy: none
		sourceColumn: Stage

	column Expected_ARR_USD
		dataType: double
		lineageTag: a0000007-0000-0000-0000-000000000005
		formatString: \$#,0
		summarizeBy: sum
		sourceColumn: Expected_ARR_USD

	column Close_Date
		dataType: dateTime
		lineageTag: a0000007-0000-0000-0000-000000000006
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: Close_Date

	column Probability_Pct
		dataType: double
		lineageTag: a0000007-0000-0000-0000-000000000007
		formatString: 0%
		summarizeBy: none
		sourceColumn: Probability_Pct

	column Forecast_Category
		dataType: string
		lineageTag: a0000007-0000-0000-0000-000000000008
		summarizeBy: none
		sourceColumn: Forecast_Category

